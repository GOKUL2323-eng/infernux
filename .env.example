# ==========================================
# Infernux Server Environment Configuration
# ==========================================

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CLIENT_URL=*
API_URL=http://localhost:4000

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/infernux

# JWT Secrets (Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_ACCESS_SECRET=infernux_dev_jwt_access_secret_key_change_in_production_123456
JWT_REFRESH_SECRET=infernux_dev_jwt_refresh_secret_key_change_in_production_789012
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# LiveKit WebRTC Cloud Credentials (Get from cloud.livekit.io)
LIVEKIT_HOST=wss://infernux-dev.livekit.cloud
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secretkey1234567890abcdef

# Storage Provider: 'local', 'cloudinary', or 's3'
STORAGE_PROVIDER=local

# Cloudinary (Optional if using local storage in development)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# Expo Push Notifications
EXPO_ACCESS_TOKEN=your_expo_access_token

# Rate Limiting
RATE_LIMIT_MAX=500
