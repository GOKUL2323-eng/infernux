{
  "expo": {
    "name": "MOZHI",
    "slug": "mozhi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mozhi",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D12"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mozhi.app",
      "infoPlist": {
        "NSCameraUsageDescription": "MOZHI needs camera access to capture photos and videos for posts, stories, reels, and video calls.",
        "NSMicrophoneUsageDescription": "MOZHI needs microphone access for voice notes, audio posts, and voice/video calling.",
        "NSPhotoLibraryUsageDescription": "MOZHI needs photo library access so you can select and share media.",
        "NSPhotoLibraryAddUsageDescription": "MOZHI needs permission to save photos and videos to your library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0D12"
      },
      "package": "com.mozhi.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MOZHI to access your camera"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow MOZHI to access your photos",
          "savePhotosPermission": "Allow MOZHI to save photos"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "ea3fc0d4-88dd-4714-b6b5-3e279cb753cc"
      }
    },
    "owner": "gokulgk10s-team"
  }
}
