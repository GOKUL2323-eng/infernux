{
  "name": "mozhi-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "MOZHI - All-in-One Social Messaging and Media Mobile Application",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "bot": "node scripts/launcher-bot.js",
    "start": "node scripts/launcher-bot.js",
    "open": "node scripts/launcher-bot.js",
    "dev:server": "npm run dev --workspace=apps/server",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "node scripts/run-e2e-audit.cjs",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "query-string": "7.1.3"
  }
}
